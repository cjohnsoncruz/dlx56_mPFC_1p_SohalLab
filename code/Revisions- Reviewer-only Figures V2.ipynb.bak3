   "source": [
    "## Quantify activity-match quality from stored per-iteration t-tests\n",
    "activity_match_file = (results_location\n",
    "    / \"figure_5_prep_mid_decoding figures_post_outcome_activity_25_Mar_2026\"\n",
    "    / \"Decode (Activity Match CCGP) 1000 iter post_outcome_activity 25_Mar_2026.parquet\")\n",
    "am_df = pd.read_parquet(activity_match_file)\n",
    "\n",
    "def summarize_match_quality(df, grouping, group):\n",
    "    \"\"\"Summarize ensemble-vs-matched-control t-test outcomes for a subset of comparisons.\"\"\"\n",
    "    p = df['p_value'].dropna()\n",
    "    return {\n",
    "        'grouping': grouping,\n",
    "        'group': group,\n",
    "        'n_comparisons': len(p),\n",
    "        'n_iterations': df['pseudopop_run_num'].nunique(),\n",
    "        'frac_p_gt_0.05': (p > 0.05).mean(),\n",
    "        'frac_p_lt_0.05': (p < 0.05).mean(),\n",
    "        'frac_p_lt_0.01': (p < 0.01).mean(),\n",
    "        'median_p': p.median(),\n",
    "        'min_p': p.min(),\n",
    "    }\n",
    "\n",
    "# Overall summary plus per-group breakdowns (each comparison = one independent two-sample t-test)\n",
    "records = [summarize_match_quality(am_df, 'overall', 'all')]\n",
    "for group_col in ['enriched_group', 'geno_day']:\n",
    "    for group_val, sub_df in am_df.groupby(group_col):\n",
    "        records.append(summarize_match_quality(sub_df, group_col, group_val))\n",
    "\n",
    "activity_match_quality_df = pd.DataFrame.from_records(records)\n",
    "activity_match_quality_df"
   ]
  },
