   "source": [
    "\n",
    "# Per-subject percentages\n",
    "subj_pct = plot_df.groupby(['task_stage', 'geno_day', 'subject_name', 'correction'])['is_enriched'].mean() * 100\n",
    "subj_pct = subj_pct.reset_index(name='pct_enriched')\n",
    "subj_pct\n"
   ]
  },
