    "cell_period_active[cell_col] = cell_period_active['subject_name'] + '-' + cell_period_active['raw_ID']\n",
    "annotate_csv(cell_period_active, 'subject_name')\n",
    "print(cell_period_active.info())\n",
    "cell_period_active.head()\n"
   ]
