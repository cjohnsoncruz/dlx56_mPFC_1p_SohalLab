   "source": [
    "#### import dff & spike datasets"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0e8c3949",
   "metadata": {},
   "outputs": [],
   "source": [
    "#set what dataset to use, therefore waht col names are improtant \n",
    "use_new_dataset = True\n",
    "if use_new_dataset:\n",
    "    #if data is from new_dataset\n",
    "    subject_col = 'subject_name'\n",
    "    unit_ID_col = 'neuron_ID'\n",
    "else:   \n",
    "    #if data is from old dataset:\n",
    "    subject_col = 'name'\n",
    "    unit_ID_col = 'unique_ID'\n",
    "stage_col = 'task_phase_vec'\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "26d6a0f2",
   "metadata": {},
   "outputs": [],
   "source": [
    "#load spike data:\n",
    "\n",
    "\n",
    "trial_df_filename = data_location /  r\"matlab-made_trial_timeseries_normalized_2026-01-31 17.parquet\"\n",
    "trial_tseries_df_norm = pd.read_parquet(trial_df_filename)\n",
    "#once loaded, derive info from metadata\n",
    "stage_names = sorted(trial_tseries_df_norm['task_phase_vec'].unique())#hardcode the stage_names (to not rely on the order of the 'unique() vector of the df\n",
    "numeric_col = get_numeric_cols_timeseries(trial_tseries_df_norm, \" to \")\n",
    "# get trial summary info\n",
    "subject_stage_info_df = get_subject_stage_info_df(trial_tseries_df_norm, cell_id_name_col = unit_ID_col, subj_name_col = 'subject_name')#.rename({unit_ID_col: \"unique_ID\"},axis = 1) # get subj level dfs\n",
    "n_total_units = trial_tseries_df_norm.groupby(by = 'geno_day')[unit_ID_col].nunique()\n",
    "\n",
    "#get processed dataset \n",
    "unit_mean_tseries =  get_unit_mean_timeseries_by_phase(trial_tseries_df_norm,['trial_num'], [subject_col, unit_ID_col,'geno_day', stage_col], numeric_col)\n",
    "print(n_total_units)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "703e55f8",
   "metadata": {},
   "outputs": [],
   "source": [
    "enriched_spikes = unit_mean_tseries.groupby(by = ['subject_name', unit_ID_col, 'geno_day'])[stage_names].first()\n",
    "enriched_spikes"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9f12e4b5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# load DFF data\n",
    "dff_file = data_location / Path(r\"matlab_import_1000_shuff_minmax_normed_trial_tseries_26-Feb-2026\\dff_matlab-made_trial_timeseries_normalized_2026-02-26 21.parquet\")\n",
    "trial_tseries_df_norm_dff = pd.read_parquet(dff_file)\n",
    "n_total_units_dff = trial_tseries_df_norm_dff.groupby(by = 'geno_day')[unit_ID_col].nunique()\n",
    "#make dff mean timeseries\n",
    "unit_mean_tseries_dff =  get_unit_mean_timeseries_by_phase(trial_tseries_df_norm_dff,['trial_num'], [subject_col, unit_ID_col,'geno_day', stage_col], numeric_col)\n",
    "\n",
